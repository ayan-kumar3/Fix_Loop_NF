NEXT_PUBLIC_APP_URL=http://localhost:5001

# Supabase project credentials. Leave blank to use the in-memory demo store.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Required only to bootstrap the first administrator. Use a random value of at
# least 24 characters and keep it server-side; never add a NEXT_PUBLIC_ prefix.
ADMIN_BOOTSTRAP_KEY=

# Optional server-side AI integration.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
